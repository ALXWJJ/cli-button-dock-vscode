        }
      },
      {
        "command": "cliButtonDock.button10.face.0",
        "title": "Agent 10",
        "icon": {
          "light": "media/runtime-icons/button10.0.light.svg",
          "dark": "media/runtime-icons/button10.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button10.face.1",
        "title": "Agent 10",
        "icon": {
          "light": "media/runtime-icons/button10.1.light.svg",
          "dark": "media/runtime-icons/button10.1.dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cliButtonDock.button01.face.0",
          "when": "cliButtonDock.button01Enabled && cliButtonDock.button01IconSlot == 0",
          "group": "navigation@200"
        },
        {
          "command": "cliButtonDock.button01.face.1",
          "when": "cliButtonDock.button01Enabled && cliButtonDock.button01IconSlot == 1",
          "group": "navigation@200"
        },
        {
          "command": "cliButtonDock.button02.face.0",
          "when": "cliButtonDock.button02Enabled && cliButtonDock.button02IconSlot == 0",
          "group": "navigation@201"
        },
        {
          "command": "cliButtonDock.button02.face.1",
          "when": "cliButtonDock.button02Enabled && cliButtonDock.button02IconSlot == 1",
          "group": "navigation@201"
        },
        {
          "command": "cliButtonDock.button03.face.0",
          "when": "cliButtonDock.button03Enabled && cliButtonDock.button03IconSlot == 0",
          "group": "navigation@202"
        },
        {
          "command": "cliButtonDock.button03.face.1",
          "when": "cliButtonDock.button03Enabled && cliButtonDock.button03IconSlot == 1",
          "group": "navigation@202"
        },
        {
          "command": "cliButtonDock.button04.face.0",
          "when": "cliButtonDock.button04Enabled && cliButtonDock.button04IconSlot == 0",
          "group": "navigation@203"
        },
        {
          "command": "cliButtonDock.button04.face.1",
          "when": "cliButtonDock.button04Enabled && cliButtonDock.button04IconSlot == 1",
          "group": "navigation@203"
        },
        {
          "command": "cliButtonDock.button05.face.0",
          "when": "cliButtonDock.button05Enabled && cliButtonDock.button05IconSlot == 0",
          "group": "navigation@204"
        },
        {
          "command": "cliButtonDock.button05.face.1",
          "when": "cliButtonDock.button05Enabled && cliButtonDock.button05IconSlot == 1",
          "group": "navigation@204"
        },
        {
          "command": "cliButtonDock.button06.face.0",
          "when": "cliButtonDock.button06Enabled && cliButtonDock.button06IconSlot == 0",
          "group": "navigation@205"
        },
        {
          "command": "cliButtonDock.button06.face.1",
          "when": "cliButtonDock.button06Enabled && cliButtonDock.button06IconSlot == 1",
          "group": "navigation@205"
        },
        {
          "command": "cliButtonDock.button07.face.0",
          "when": "cliButtonDock.button07Enabled && cliButtonDock.button07IconSlot == 0",
          "group": "navigation@206"
        },
        {
          "command": "cliButtonDock.button07.face.1",
          "when": "cliButtonDock.button07Enabled && cliButtonDock.button07IconSlot == 1",
          "group": "navigation@206"
        },
        {
          "command": "cliButtonDock.button08.face.0",
          "when": "cliButtonDock.button08Enabled && cliButtonDock.button08IconSlot == 0",
          "group": "navigation@207"
        },
        {
          "command": "cliButtonDock.button08.face.1",
          "when": "cliButtonDock.button08Enabled && cliButtonDock.button08IconSlot == 1",
          "group": "navigation@207"
        },
        {
          "command": "cliButtonDock.button09.face.0",
          "when": "cliButtonDock.button09Enabled && cliButtonDock.button09IconSlot == 0",
          "group": "navigation@208"
        },
        {
          "command": "cliButtonDock.button09.face.1",
          "when": "cliButtonDock.button09Enabled && cliButtonDock.button09IconSlot == 1",
          "group": "navigation@208"
        },
        {
          "command": "cliButtonDock.button10.face.0",
          "when": "cliButtonDock.button10Enabled && cliButtonDock.button10IconSlot == 0",
          "group": "navigation@209"
        },
        {
          "command": "cliButtonDock.button10.face.1",
          "when": "cliButtonDock.button10Enabled && cliButtonDock.button10IconSlot == 1",
          "group": "navigation@209"
        },
        {
          "command": "cliButtonDock.configure",
          "group": "navigation@211"
        }
      ],
      "editor/title/context": [
        {
          "command": "cliButtonDock.configure",
          "group": "navigation@211"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cliButtonDock.configure",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "win": "ctrl+alt+a",
        "linux": "ctrl+alt+a"
      },
      {
        "command": "cliButtonDock.addFilepathToTerminal",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+k",
        "linux": "ctrl+alt+k"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "cliButtonDock.buttons": {
          "type": "array",
          "description": "%configuration.buttons.description%",
          "scope": "machine-overridable",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "enabled",
              "label",
              "icon",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "preset": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string",
                "description": "Emoji or brand icon id, inline SVG, data image URI, or HTTPS image URL. Custom images are cached locally."
              },
              "command": {
                "type": "string"
              },
              "cwd": {
                "type": "string",
                "enum": [
                  "current",
                  "workspace",
                  "file"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "cliButtonDock.customIconSlots": {
          "type": "object",
          "description": "Internal title-bar custom icon slot indices per button id.",
          "scope": "machine-overridable",
          "default": {}
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "check": "bun run check-types && bun run lint && bun run test",
    "compile": "bun run check && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "sync-contributes": "bun run scripts/sync-package-contributes.ts",
    "package": "bun run check && bun run sync-contributes && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "bun test test",
    "format": "eslint src --fix",
    "vsix": "bun x @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
