{
  "name": "cli-button-dock",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.5",
  "publisher": "ALXWJJ",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALXWJJ/cli-button-dock-vscode"
  },
  "homepage": "https://github.com/ALXWJJ/cli-button-dock-vscode#readme",
  "bugs": {
    "url": "https://github.com/ALXWJJ/cli-button-dock-vscode/issues"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#161616",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vscode-extension",
    "terminal",
    "cli",
    "ai",
    "coding-agent",
    "opencode",
    "codex",
    "claude-code",
    "gemini-cli",
    "cursor-agent",
    "github-copilot",
    "qwen-code",
    "deepseek",
    "kimi-code",
    "cline",
    "openclaw",
    "mimo-code",
    "antigravity",
    "minimax"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cliButtonDock.configure",
        "title": "%command.configure%",
        "icon": {
          "light": "images/icon.png",
          "dark": "images/icon.png"
        }
      },
      {
        "command": "cliButtonDock.addFilepathToTerminal",
        "title": "%command.addFilepathToTerminal%"
      },
      {
        "command": "cliButtonDock.button01",
        "title": "OpenCode",
        "icon": {
          "light": "media/brands/opencode.svg",
          "dark": "media/brands/opencode.svg"
        }
      },
      {
        "command": "cliButtonDock.button02",
        "title": "Codex",
        "icon": {
          "light": "media/brands/codex.svg",
          "dark": "media/brands/codex.svg"
        }
      },
      {
        "command": "cliButtonDock.button03",
        "title": "Claude Code",
        "icon": {
          "light": "media/brands/claude.svg",
          "dark": "media/brands/claude.svg"
        }
      },
      {
        "command": "cliButtonDock.button04",
        "title": "Gemini CLI",
        "icon": {
          "light": "media/brands/gemini.svg",
          "dark": "media/brands/gemini.svg"
        }
      },
      {
        "command": "cliButtonDock.button05",
        "title": "Qwen Code",
        "icon": {
          "light": "media/brands/qwen.svg",
          "dark": "media/brands/qwen.svg"
        }
      },
      {
        "command": "cliButtonDock.button06",
        "title": "Agent 06",
        "icon": "$(terminal)"
      },
      {
        "command": "cliButtonDock.button07",
        "title": "Agent 07",
        "icon": "$(terminal)"
      },
      {
        "command": "cliButtonDock.button08",
        "title": "Agent 08",
        "icon": "$(terminal)"
      },
      {
        "command": "cliButtonDock.button09",
        "title": "Agent 09",
        "icon": "$(terminal)"
      },
      {
        "command": "cliButtonDock.button10",
        "title": "Agent 10",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cliButtonDock.button01",
          "when": "cliButtonDock.button01Enabled",
          "group": "navigation@1"
        },
        {
          "command": "cliButtonDock.button02",
          "when": "cliButtonDock.button02Enabled",
          "group": "navigation@2"
        },
        {
          "command": "cliButtonDock.button03",
          "when": "cliButtonDock.button03Enabled",
          "group": "navigation@3"
        },
        {
          "command": "cliButtonDock.button04",
          "when": "cliButtonDock.button04Enabled",
          "group": "navigation@4"
        },
        {
          "command": "cliButtonDock.button05",
          "when": "cliButtonDock.button05Enabled",
          "group": "navigation@5"
        },
        {
          "command": "cliButtonDock.button06",
          "when": "cliButtonDock.button06Enabled",
          "group": "navigation@6"
        },
        {
          "command": "cliButtonDock.button07",
          "when": "cliButtonDock.button07Enabled",
          "group": "navigation@7"
        },
        {
          "command": "cliButtonDock.button08",
          "when": "cliButtonDock.button08Enabled",
          "group": "navigation@8"
        },
        {
          "command": "cliButtonDock.button09",
          "when": "cliButtonDock.button09Enabled",
          "group": "navigation@9"
        },
        {
          "command": "cliButtonDock.button10",
          "when": "cliButtonDock.button10Enabled",
          "group": "navigation@10"
        },
        {
          "command": "cliButtonDock.configure",
          "group": "navigation@99"
        }
      ],
      "editor/title/context": [
        {
          "command": "cliButtonDock.configure",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cliButtonDock.configure",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "win": "ctrl+alt+a",
        "linux": "ctrl+alt+a"
      },
      {
        "command": "cliButtonDock.addFilepathToTerminal",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+k",
        "linux": "ctrl+alt+k"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "cliButtonDock.buttons": {
          "type": "array",
          "description": "%configuration.buttons.description%",
          "default": [],
          "items": {
            "type": "object",
            "required": ["id", "enabled", "label", "icon", "command"],
            "properties": {
              "id": { "type": "string" },
              "enabled": { "type": "boolean" },
              "preset": { "type": "string" },
              "label": { "type": "string" },
              "icon": {
                "type": "string",
                "description": "Emoji or brand icon id, inline SVG, data image URI, or HTTPS image URL. Custom images are cached locally."
              },
              "command": { "type": "string" },
              "cwd": { "type": "string", "enum": ["current", "workspace", "file"] }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "check": "bun run check-types && bun run lint && bun run test",
    "compile": "bun run check && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "bun test test",
    "format": "eslint src --fix",
    "vsix": "bun x @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.94.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
