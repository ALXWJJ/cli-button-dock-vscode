        "icon": {
          "light": "media/runtime-icons/button07.0.light.svg",
          "dark": "media/runtime-icons/button07.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button07.face.1",
        "title": "Agent 07",
        "icon": {
          "light": "media/runtime-icons/button07.1.light.svg",
          "dark": "media/runtime-icons/button07.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button08.face.0",
        "title": "Agent 08",
        "icon": {
          "light": "media/runtime-icons/button08.0.light.svg",
          "dark": "media/runtime-icons/button08.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button08.face.1",
        "title": "Agent 08",
        "icon": {
          "light": "media/runtime-icons/button08.1.light.svg",
