{
  "name": "cli-button-dock",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.2",
  "publisher": "ALXWJJ",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALXWJJ/cli-button-dock-vscode"
  },
  "homepage": "https://marketplace.visualstudio.com/items?itemName=ALXWJJ.cli-button-dock",
  "bugs": {
    "url": "https://github.com/ALXWJJ/cli-button-dock-vscode/issues"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#161616",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vscode-extension",
    "terminal",
    "cli",
    "ai",
    "coding-agent",
    "opencode",
    "codex",
    "claude-code",
    "gemini-cli",
    "cursor-agent",
    "github-copilot",
    "qwen-code",
    "deepseek",
    "kimi-code",
    "cline",
    "openclaw",
    "mimo-code",
    "antigravity",
    "minimax"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cliButtonDock.configure",
        "title": "%command.configure%",
        "icon": {
          "light": "images/icon.png",
          "dark": "images/icon.png"
        }
      },
      {
        "command": "cliButtonDock.addFilepathToTerminal",
        "title": "%command.addFilepathToTerminal%"
      },
      {
        "command": "cliButtonDock.button01.face.0",
        "title": "OpenCode",
        "icon": {
          "light": "media/runtime-icons/button01.0.light.svg",
          "dark": "media/runtime-icons/button01.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button01.face.1",
        "title": "OpenCode",
        "icon": {
          "light": "media/runtime-icons/button01.1.light.svg",
          "dark": "media/runtime-icons/button01.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button02.face.0",
        "title": "Codex",
        "icon": {
          "light": "media/runtime-icons/button02.0.light.svg",
          "dark": "media/runtime-icons/button02.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button02.face.1",
        "title": "Codex",
        "icon": {
          "light": "media/runtime-icons/button02.1.light.svg",
          "dark": "media/runtime-icons/button02.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button03.face.0",
        "title": "Claude Code",
        "icon": {
          "light": "media/runtime-icons/button03.0.light.svg",
          "dark": "media/runtime-icons/button03.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button03.face.1",
        "title": "Claude Code",
        "icon": {
          "light": "media/runtime-icons/button03.1.light.svg",
          "dark": "media/runtime-icons/button03.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button04.face.0",
        "title": "Gemini CLI",
        "icon": {
          "light": "media/runtime-icons/button04.0.light.svg",
          "dark": "media/runtime-icons/button04.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button04.face.1",
        "title": "Gemini CLI",
        "icon": {
          "light": "media/runtime-icons/button04.1.light.svg",
          "dark": "media/runtime-icons/button04.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button05.face.0",
        "title": "Qwen Code",
        "icon": {
          "light": "media/runtime-icons/button05.0.light.svg",
          "dark": "media/runtime-icons/button05.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button05.face.1",
        "title": "Qwen Code",
        "icon": {
          "light": "media/runtime-icons/button05.1.light.svg",
          "dark": "media/runtime-icons/button05.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button06.face.0",
        "title": "Agent 06",
        "icon": {
          "light": "media/runtime-icons/button06.0.light.svg",
          "dark": "media/runtime-icons/button06.0.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button06.face.1",
        "title": "Agent 06",
        "icon": {
          "light": "media/runtime-icons/button06.1.light.svg",
          "dark": "media/runtime-icons/button06.1.dark.svg"
        }
      },
      {
        "command": "cliButtonDock.button07.face.0",
