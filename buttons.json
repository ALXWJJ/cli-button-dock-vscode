{
  "$schema": "./buttons.schema.json",
  "buttons": [
    {
      "id": "open",
      "title": "Open opencode",
      "icon": {
        "light": "images/button-dark.svg",
        "dark": "images/button-light.svg"
      },
      "command": "opencode --port {{port}}",
      "terminalName": "opencode",
      "reuseTerminal": true,
      "runOnReuse": false,
      "context": "opencode",
      "keybinding": "ctrl+escape"
    },
    {
      "id": "new-session",
      "title": "New opencode session",
      "icon": "$(sparkle)",
      "command": "opencode --port {{port}}",
      "terminalName": "opencode",
      "reuseTerminal": false,
      "context": "opencode",
      "keybinding": "ctrl+shift+escape"
    },
    {
      "id": "codex",
      "title": "Open Codex",
      "icon": "$(terminal)",
      "command": "codex",
      "terminalName": "Codex",
      "reuseTerminal": true,
      "runOnReuse": false
    }
  ]
}
